# =============================================================================
# TicketFlow — Environment Configuration
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is gitignored — never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (shared instance, one schema per microservice)
# -----------------------------------------------------------------------------
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ticketflow
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (seat holds, session cache, pub/sub for WebSocket fan-out)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# RabbitMQ (async events: booking.confirmed, booking.cancelled, waitlist.offer, etc.)
# -----------------------------------------------------------------------------
RABBITMQ_USER=ticketflow
RABBITMQ_PASSWORD=change_me_strong_password
RABBITMQ_VHOST=/ticketflow
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# -----------------------------------------------------------------------------
# ElasticSearch (event search & filtering)
# -----------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200

# -----------------------------------------------------------------------------
# JWT (shared secret across services for token verification)
# Generate: openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_use_openssl_rand_base64_64
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# Seat Hold / Waitlist timing (business config)
# -----------------------------------------------------------------------------
SEAT_HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Email (Gmail SMTP — use a 16-char App Password, NOT your normal password)
# Generate at: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
MAIL_FROM_ADDRESS=your_gmail_address@gmail.com

# -----------------------------------------------------------------------------
# Service ports (host-side, used by docker-compose port mapping)
# -----------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
VENUE_EVENT_SERVICE_PORT=8082
SEAT_HOLD_SERVICE_PORT=8083
BOOKING_SERVICE_PORT=8084
WAITLIST_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
FRONTEND_PORT=3000
NGINX_PORT=80

# -----------------------------------------------------------------------------
# Frontend build-time vars (consumed via Vite, proxied through Nginx)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost/api
VITE_WS_BASE_URL=ws://localhost/ws

# -----------------------------------------------------------------------------
# Waitlist offer flow
# -----------------------------------------------------------------------------
# How long a customer has to claim an offered seat before it cascades to the
# next person in the queue.
WAITLIST_SWEEP_INTERVAL_MS=30000

# Externally reachable origin. Baked into the claim links inside offer emails —
# an internal service name here produces links nobody can open.
PUBLIC_BASE_URL=http://localhost

# -----------------------------------------------------------------------------
# SMTP. Gmail: enable 2FA then create an App Password at
# https://myaccount.google.com/apppasswords — the account password will NOT work.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_FROM_NAME=TicketFlow

# Set false to render and log emails without sending — demos the full pipeline
# with no SMTP credentials configured.
MAIL_DELIVERY_ENABLED=true
